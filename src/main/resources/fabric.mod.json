{
  "schemaVersion": 1,
  "id": "allblockvariants",
  "version": "${version}",

  "name": "All Block Variants Mod",
  "description": "All Block Variants",
  "authors": [
    "Brenton \"B-Train\" Fletcher"
  ],
  "contact": {
    "homepage": "https://github.com/bloopletech/allblockvariants",
    "sources": "https://github.com/bloopletech/allblockvariants"
  },

